# Task runner for the users service.
#
# The users service is its own Go module exposing a gRPC API and owning the
# database schema. Migrations are managed with dbmate; generated DB code with
# sqlc.

set shell := ["zsh", "-cu"]

# =============================================================================
# Configuration
# =============================================================================

# Shared database that stores one schema per service. Override with DATABASE_URL if needed.
db_name := "trading"

# Postgres schema owned by the users service.
schema := "users"

db_url := env_var_or_default("DATABASE_URL", "postgres://postgres:postgres@localhost:5432/" + db_name + "?sslmode=disable")

# Directory containing dbmate migration files.
migrations := "internal/adapters/out/postgres/migrations"

# Docker Compose service name for the local Postgres container. Used by pg_dump.
pg_container := "trading-postgres"

# Schema file consumed by sqlc, regenerated from the migrated database.
schema_file := "internal/adapters/out/postgres/schema.sql"

# =============================================================================
# Service lifecycle
# =============================================================================

# Legacy microservices form: run the users service on its own.
# run:
#     go run ./cmd

# Legacy microservices form: build the users binary on its own.
# build:
#     go build -o bin/users ./cmd

# Run the test suite, starting from a clean test cache.
test: cache-clean
    go test ./...

# =============================================================================
# Code quality
# =============================================================================

# Format Go code with gofmt.
fmt:
    gofmt -w .

# Vet Go code with the standard vet tool.
vet:
    go vet ./...

# Tidy dependencies with the workspace disabled so go.mod/go.sum stay self-sufficient.
tidy:
    GOWORK=off go mod tidy

# =============================================================================
# Database migrations
# =============================================================================

# Apply all pending DB migrations.
migrate: schema-create
    PGOPTIONS="-c search_path={{schema}}" dbmate --url "{{db_url}}" --migrations-dir "{{migrations}}" up

# Regenerate sqlc schema.sql from the migrated database.
schema: migrate
    docker exec {{pg_container}} pg_dump --schema-only --no-owner --no-privileges \
        --schema={{schema}} --exclude-table={{schema}}.schema_migrations \
        "{{db_url}}" | sed 's/{{schema}}\.//g' | grep -v '^CREATE SCHEMA' | grep -v '^\\' > "{{schema_file}}"

# Roll back the last migration batch.
down: schema-create
    PGOPTIONS="-c search_path={{schema}}" dbmate --url "{{db_url}}" --migrations-dir "{{migrations}}" down

# Drop and reapply this service's schema.
clean: db-create
    docker exec {{pg_container}} psql -U postgres -d {{db_name}} -v ON_ERROR_STOP=1 \
        -c 'DROP SCHEMA IF EXISTS {{schema}} CASCADE; CREATE SCHEMA {{schema}};'
    PGOPTIONS="-c search_path={{schema}}" dbmate --url "{{db_url}}" --migrations-dir "{{migrations}}" up

# Create a new migration file.
new name:
    dbmate --url "{{db_url}}" --migrations-dir "{{migrations}}" new {{name}}

# Show pending/applied migrations.
status: schema-create
    PGOPTIONS="-c search_path={{schema}}" dbmate --url "{{db_url}}" --migrations-dir "{{migrations}}" status

# =============================================================================
# Private helpers
# =============================================================================

# Clear the Go test cache so `just test` always runs the full suite.
[private]
cache-clean:
    go clean -testcache

# Create the database if it does not exist yet.
[private]
db-create:
    dbmate --url "{{db_url}}" create 2>/dev/null || true

# Create this service's schema if it does not exist yet.
[private]
schema-create: db-create
    docker exec {{pg_container}} psql -U postgres -d {{db_name}} -v ON_ERROR_STOP=1 \
        -c 'CREATE SCHEMA IF NOT EXISTS {{schema}};'
