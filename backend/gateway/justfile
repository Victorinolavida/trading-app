set shell := ["zsh", "-cu"]

# Run the gateway service
run:
    go run ./cmd

# Build the gateway binary
build:
    go build -o bin/gateway ./cmd

# Run tests
test: cache-clean
    go test ./...

# Format Go code
fmt:
    gofmt -w .

# Vet Go code
vet:
    go vet ./...

# Tidy module dependencies (workspace disabled so go.mod/go.sum stay self-sufficient)
tidy:
    GOWORK=off go mod tidy

[private]
cache-clean:
    go clean -testcache
