# Task runner for the securities service.
#
# The securities service is its own Go module exposing a gRPC API and owning the
# database schema. Migrations are managed with dbmate; generated DB code with
# sqlc.

set shell := ["zsh", "-cu"]

# =============================================================================
# Configuration
# =============================================================================

# Database owned by the securities service. Override with DATABASE_URL if needed.
db_url := env_var_or_default("DATABASE_URL", "postgres://postgres:postgres@localhost:5432/trading_securities?sslmode=disable")

# Directory containing dbmate migration files.
migrations := "internal/adapters/out/postgres/migrations"

# Docker Compose service name for the local Postgres container. Used by pg_dump.
pg_container := "trading-postgres"

# Schema file consumed by sqlc, regenerated from the migrated database.
schema_file := "internal/adapters/out/postgres/schema.sql"

# Directory containing idempotent seed SQL files.
seeds := "internal/adapters/out/postgres/seeds"

# =============================================================================
# Service lifecycle
# =============================================================================

# Run the securities service.
run:
    go run ./cmd

# Build the securities binary into ./bin/securities.
build:
    go build -o bin/securities ./cmd

# Run the test suite, starting from a clean test cache.
test:
    go test -count=1 ./...

# =============================================================================
# Code quality
# =============================================================================

# Format Go code with gofmt.
fmt:
    gofmt -w .

# Vet Go code with the standard vet tool.
vet:
    go vet ./...

# Tidy dependencies with the workspace disabled so go.mod/go.sum stay self-sufficient.
tidy:
    GOWORK=off go mod tidy

# =============================================================================
# Database migrations
# =============================================================================

# Apply all pending DB migrations.
migrate: db-create
    dbmate --url "{{db_url}}" --migrations-dir "{{migrations}}" up

# Apply pending migrations (alias for migrate).
up: migrate

# Regenerate sqlc schema.sql from the migrated database.
schema: migrate
    docker exec {{pg_container}} pg_dump --schema-only --no-owner --no-privileges \
        --exclude-table=schema_migrations "{{db_url}}" | grep -v '^\\' > "{{schema_file}}"

# Roll back the last migration batch.
down: db-create
    dbmate --url "{{db_url}}" --migrations-dir "{{migrations}}" down

# Drop the database and reapply all migrations.
clean: db-create
    dbmate --url "{{db_url}}" --migrations-dir "{{migrations}}" drop
    dbmate --url "{{db_url}}" --migrations-dir "{{migrations}}" up

# Create a new migration file.
new name:
    dbmate --url "{{db_url}}" --migrations-dir "{{migrations}}" new {{name}}

# Show pending/applied migrations.
status: db-create
    dbmate --url "{{db_url}}" --migrations-dir "{{migrations}}" status

# Import supplied historical UDI quotes without overwriting existing values.
seed-udi: migrate
    docker exec -i {{pg_container}} psql -U postgres -d trading_securities -v ON_ERROR_STOP=1 -c 'CREATE TEMP TABLE udi_seed (date date, value numeric)' -c '\copy udi_seed (date, value) FROM STDIN WITH (FORMAT csv, HEADER true)' -c 'INSERT INTO udi_values (date, value) SELECT date, value FROM udi_seed ON CONFLICT (date) DO NOTHING' < internal/adapters/out/postgres/seed_data/udi.csv

# Seed UDI quotes and reference securities. Idempotent.
seed: seed-udi
    for f in {{seeds}}/*.sql; do docker exec -i {{pg_container}} psql -U postgres -d trading_securities -v ON_ERROR_STOP=1 < "$f"; done

# =============================================================================
# Private helpers
# =============================================================================

# Create the database if it does not exist yet.
[private]
db-create:
    dbmate --url "{{db_url}}" create 2>/dev/null || true
