# Task runner for the Go backend workspace.
#
# Each service lives in its own module (see go.work) and has its own justfile.
# The recipes below fan out to those modules, accepting either a single service
# name or `all` where documented.

set shell := ["zsh", "-cu"]

# =============================================================================
# Modules
# =============================================================================

mod gateway "gateway"
mod users "users"
mod securities "securities"

# =============================================================================
# Configuration
# =============================================================================

# Every backend service. Used by the `all` target of the dispatch helpers.
services := "gateway users securities"

# Services that own database migrations. Used by the `all` target of DB recipes.
db_services := "users securities"

# =============================================================================
# Default
# =============================================================================

# List the recipes available at the backend level.
default:
    @just --list

# =============================================================================
# Local setup
# =============================================================================

# Create local config files from the checked-in examples, if missing.
setup:
    #!/usr/bin/env zsh
    # Existing config files are left untouched. Run this once after cloning,
    # then edit `<service>/config/config.yaml` as needed.
    set -eu
    for s in {{services}}; do
        if [[ -f "$s/config/config.yaml" ]]; then
            echo "$s/config/config.yaml already exists"
        else
            cp "$s/config/config.example.yaml" "$s/config/config.yaml"
            echo "created $s/config/config.yaml from example"
        fi
    done

# =============================================================================
# Service lifecycle
# =============================================================================

# Run a service: `just run users` or `just run all`.
run service:
    just _each run {{service}}

# Build a service binary: `just build users` or `just build all`.
build service:
    just _each build {{service}}

# Run a service's tests: `just test users` or `just test all`.
test service:
    just _each test {{service}}

# =============================================================================
# Code quality
# =============================================================================

# Format Go code: `just fmt` (all) or `just fmt users`.
fmt service="all":
    #!/usr/bin/env zsh
    set -eu
    if [[ "{{service}}" == "all" ]]; then
        just _each fmt all
        gofmt -w pkg
    else
        just "{{service}}" fmt
    fi

# Vet Go code: `just vet` (all) or `just vet users`.
vet service="all":
    #!/usr/bin/env zsh
    set -eu
    if [[ "{{service}}" == "all" ]]; then
        just _each vet all
        go vet ./pkg/...
    else
        just "{{service}}" vet
    fi

# Tidy dependencies with the workspace disabled so go.mod/go.sum stay self-sufficient.
tidy service="all":
    #!/usr/bin/env zsh
    set -eu
    if [[ "{{service}}" == "all" ]]; then
        just _each tidy all
        (cd pkg && GOWORK=off go mod tidy)
        (cd gen && GOWORK=off go mod tidy)
    else
        just "{{service}}" tidy
    fi

# =============================================================================
# Database migrations
# =============================================================================

# Apply pending DB migrations: `just migrate users` or `just migrate all`.
migrate service:
    just _db migrate {{service}}

# Roll back the last migration batch: `just down users` or `just down all`.
down service:
    just _db down {{service}}

# Drop the database and reapply migrations: `just clean users` or `just clean all`.
clean service:
    just _db clean {{service}}

# Show migration status: `just status users` or `just status all`.
status service:
    just _db status {{service}}

# Regenerate sqlc schema.sql: `just schema users` or `just schema all`.
schema service:
    just _db schema {{service}}

# =============================================================================
# Code generation
# =============================================================================

# Generate Go code from the protobuf definitions in backend/proto.
gen-proto:
    @buf generate
    @echo "proto code generated in gen/"

# =============================================================================
# Service scaffolding
# =============================================================================

# Scaffold a new service: `just new payments [module]`.
new name module="":
    zsh scripts/new-service.sh "{{name}}" "{{module}}"

# =============================================================================
# Private helpers
# =============================================================================

# Dispatch a command to one service, or every service when `service` is `all`.
[private]
_each cmd service:
    #!/usr/bin/env zsh
    set -eu
    if [[ "{{service}}" == "all" ]]; then
        for s in {{services}}; do
            just "$s" "{{cmd}}"
        done
    elif [[ " {{services}} " == *" {{service}} "* ]]; then
        just "{{service}}" "{{cmd}}"
    else
        echo "unknown service '{{service}}' (expected: {{services}} or all)" >&2
        exit 2
    fi

# Dispatch a DB command to one service, or every DB service when `service` is `all`.
[private]
_db cmd service:
    #!/usr/bin/env zsh
    set -eu
    if [[ "{{service}}" == "all" ]]; then
        for s in {{db_services}}; do
            just "$s" "{{cmd}}"
        done
    elif [[ " {{db_services}} " == *" {{service}} "* ]]; then
        just "{{service}}" "{{cmd}}"
    else
        echo "unknown service '{{service}}' (expected: {{db_services}} or all)" >&2
        exit 2
    fi
