# Task runner for the Go backend workspace.
#
# The monolith lives in app/. The legacy service justfiles are only invoked
# internally by the test and code-quality recipes.

set shell := ["zsh", "-cu"]

# =============================================================================
# Modules
# =============================================================================

mod app "app"

# Modules that make up the monolith. Used by the `all` targets below.
modules := "gateway users securities orders"

# =============================================================================
# Default
# =============================================================================

# List the recipes available at the backend level.
default:
    @just --list

# =============================================================================
# Local setup
# =============================================================================

# Create local config files from the checked-in examples, if missing.
setup:
    #!/usr/bin/env zsh
    # Existing config files are left untouched. Run this once after cloning,
    # then edit `<service>/config/config.yaml` as needed.
    set -eu
    for s in {{modules}} app; do
        if [[ -f "$s/config/config.yaml" ]]; then
            echo "$s/config/config.yaml already exists"
        else
            cp "$s/config/config.example.yaml" "$s/config/config.yaml"
            echo "created $s/config/config.yaml from example"
        fi
    done

# =============================================================================
# Monolith lifecycle
# =============================================================================

# Run the modular monolith (all bounded contexts in one process).
run:
    just app run

# Build the modular monolith binary.
build:
    just app build

# Run every test suite: monolith plus each module.
test:
    just app test
    just _each test all

# =============================================================================
# Code quality
# =============================================================================

# Format Go code.
fmt:
    just _each fmt all
    just app fmt
    gofmt -w pkg

# Vet Go code.
vet:
    just _each vet all
    just app vet
    go vet ./pkg/...

# Tidy dependencies with the workspace disabled so go.mod/go.sum stay self-sufficient.
tidy:
    just _each tidy all
    (cd app && GOWORK=off go mod tidy)
    (cd pkg && GOWORK=off go mod tidy)
    (cd gen && GOWORK=off go mod tidy)

# =============================================================================
# Private helpers
# =============================================================================

# Dispatch a command to one module, or every module when `module` is `all`.
[private]
_each cmd module:
    #!/usr/bin/env zsh
    set -eu
    if [[ "{{module}}" == "all" ]]; then
        for s in {{modules}}; do
            just --justfile "$s/justfile" "{{cmd}}"
        done
    elif [[ " {{modules}} " == *" {{module}} "* ]]; then
        just --justfile "{{module}}/justfile" "{{cmd}}"
    else
        echo "unknown module '{{module}}' (expected: {{modules}} or all)" >&2
        exit 2
    fi
