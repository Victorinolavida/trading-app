set shell := ["zsh", "-cu"]

mod gateway "gateway"
mod users "users"

# All backend services
services := "gateway users"

# Services that own DB migrations (used by the `all` argument)
db_services := "users"

default:
    @just --list

# Run a service: `just run users` or `just run all`
run service:
    just _each run {{service}}

# Build a service: `just build users` or `just build all`
build service:
    just _each build {{service}}

# Run tests: `just test users` or `just test all`
test service:
    just _each test {{service}}

# Format Go code: `just fmt` (all) or `just fmt users`
fmt service="all":
    #!/usr/bin/env zsh
    set -eu
    if [[ "{{service}}" == "all" ]]; then
        just _each fmt all
        gofmt -w pkg
    else
        just "{{service}}" fmt
    fi

# Vet Go code: `just vet` (all) or `just vet users`
vet service="all":
    #!/usr/bin/env zsh
    set -eu
    if [[ "{{service}}" == "all" ]]; then
        just _each vet all
        go vet ./pkg/...
    else
        just "{{service}}" vet
    fi

# Apply pending DB migrations: `just migrate users` or `just migrate all`
migrate service:
    just _db migrate {{service}}

# Roll back the last migration batch: `just down users` or `just down all`
down service:
    just _db down {{service}}

# Drop the database and reapply migrations: `just clean users` or `just clean all`
clean service:
    just _db clean {{service}}

# Show migration status: `just status users` or `just status all`
status service:
    just _db status {{service}}

# Regenerate sqlc schema.sql: `just schema users` or `just schema all`
schema service:
    just _db schema {{service}}

# Generate Go code from proto files
gen-proto:
    @buf generate
    @echo "proto code generated in gen/"

[private]
_each cmd service:
    #!/usr/bin/env zsh
    set -eu
    if [[ "{{service}}" == "all" ]]; then
        for s in {{services}}; do
            just "$s" "{{cmd}}"
        done
    elif [[ " {{services}} " == *" {{service}} "* ]]; then
        just "{{service}}" "{{cmd}}"
    else
        echo "unknown service '{{service}}' (expected: {{services}} or all)" >&2
        exit 2
    fi

[private]
_db cmd service:
    #!/usr/bin/env zsh
    set -eu
    if [[ "{{service}}" == "all" ]]; then
        for s in {{db_services}}; do
            just "$s" "{{cmd}}"
        done
    elif [[ " {{db_services}} " == *" {{service}} "* ]]; then
        just "{{service}}" "{{cmd}}"
    else
        echo "unknown service '{{service}}' (expected: {{db_services}} or all)" >&2
        exit 2
    fi
